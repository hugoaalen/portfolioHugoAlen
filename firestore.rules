rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "hugoaalen@gmail.com";
    }

    match /projects/{projectId} {
      allow read: if isAdmin()
        || (resource.data.visible == true && resource.data.status == "published");
      allow create, update, delete: if isAdmin();
    }

    match /content/{contentId} {
      allow read: if contentId == "profile";
      allow create, update, delete: if isAdmin();
    }

    match /about/{itemId} {
      allow read: if isAdmin() || resource.data.visible == true;
      allow create, update, delete: if isAdmin();
    }

    match /experience/{itemId} {
      allow read: if isAdmin() || resource.data.visible == true;
      allow create, update, delete: if isAdmin();
    }

    match /education/{itemId} {
      allow read: if isAdmin() || resource.data.visible == true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
