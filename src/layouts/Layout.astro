---
import "@fontsource-variable/onest";
import "@/styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const isAdminRoute = Astro.url.pathname.startsWith("/admin");
const robots = isAdminRoute ? "noindex, nofollow" : "index, follow";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} id="meta-description" />
    <meta name="robots" content={robots} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#c5ff4a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Portfolio de Hugo Alén" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} id="og-title" />
    <meta property="og:description" content={description} id="og-description" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL("/portfolio.webp", canonicalURL)} />
    <meta property="og:image:width" content="960" />
    <meta property="og:image:height" content="725" />
    <meta property="og:image:alt" content="Portfolio profesional de Hugo Alén" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} id="twitter-title" />
    <meta name="twitter:description" content={description} id="twitter-description" />
    <meta name="twitter:image" content={new URL("/portfolio.webp", canonicalURL)} />
    <title id="page-title">{title}</title>
    <script is:inline>
      (() => {
        const preference = localStorage.getItem("theme") || "system";
        const isDark =
          preference === "dark" ||
          (preference === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    {!isAdminRoute && <ClientRouter />}
  </head>

  <body class="relative overflow-x-hidden text-black dark:text-white">
    <div class="site-background" aria-hidden="true"></div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: light;
        --accent: 197 255 74;
        --ink: 17 17 17;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
        background: #ecece7;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
        background: transparent;
      }

      html.dark {
        background: #080808;
        color-scheme: dark;
      }

      ::selection {
        color: #111;
        background: rgb(var(--accent));
      }

      .site-background {
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        background:
          radial-gradient(circle at 88% 8%, rgb(197 255 74 / 0.32), transparent 24rem),
          linear-gradient(135deg, transparent 0 72%, rgb(255 255 255 / 0.7) 72% 100%),
          #ecece7;
      }

      .dark .site-background {
        background:
          radial-gradient(circle at 88% 8%, rgb(197 255 74 / 0.16), transparent 26rem),
          linear-gradient(135deg, transparent 0 72%, rgb(255 255 255 / 0.025) 72% 100%),
          #080808;
      }

      .site-background::after {
        content: "";
        position: absolute;
        inset: 0;
        opacity: 0.55;
        background-image: linear-gradient(rgb(15 23 42 / 0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgb(15 23 42 / 0.07) 1px, transparent 1px);
        background-size: 32px 32px;
        mask-image: linear-gradient(to bottom, black, transparent 80%);
      }

      .dark .site-background::after {
        opacity: 0.35;
        background-image: linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
          linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      @media (prefers-color-scheme: dark) {
        body {
          color: rgba(255, 255, 255, 0.9);
        }
      }

      :focus-visible {
        outline: 2px solid rgb(var(--accent));
        outline-offset: 4px;
      }

      .section-title {
        position: relative;
        width: fit-content;
        padding: 0.45rem 0.8rem;
        color: #111;
        border: 2px solid currentColor;
        background: rgb(var(--accent));
        box-shadow: 6px 6px 0 currentColor;
        transform: rotate(-1deg);
      }

      .dark .section-title {
        color: #111;
      }
    </style>
    
    <script>
      const metaTitles = {
        es: "Hugo Alén | Software & Systems Engineer",
        en: "Hugo Alén | Software & Systems Engineer"
      };
      
      const metaDescriptions = {
        es: "Portfolio de Hugo Alén, Software & Systems Engineer especializado en backend, automatización, Cloud, DevOps e infraestructura.",
        en: "Hugo Alén's portfolio. Software & Systems Engineer specializing in backend development, automation, Cloud, DevOps, and infrastructure."
      };
      
      function updateMetaTags() {
        const lang = localStorage.getItem('language') || 'es';
        document.documentElement.lang = lang;
        
        // Actualizar title
        const titleEl = document.getElementById('page-title');
        if (titleEl) titleEl.textContent = metaTitles[lang as keyof typeof metaTitles] || metaTitles.es;
        
        // Actualizar description
        const descriptionEl = document.getElementById('meta-description');
        if (descriptionEl) descriptionEl.setAttribute('content', metaDescriptions[lang as keyof typeof metaDescriptions] || metaDescriptions.es);

        const title = metaTitles[lang as keyof typeof metaTitles] || metaTitles.es;
        const description = metaDescriptions[lang as keyof typeof metaDescriptions] || metaDescriptions.es;
        document.getElementById('og-title')?.setAttribute('content', title);
        document.getElementById('og-description')?.setAttribute('content', description);
        document.getElementById('twitter-title')?.setAttribute('content', title);
        document.getElementById('twitter-description')?.setAttribute('content', description);
      }
      
      updateMetaTags();
      window.addEventListener('languageChanged', updateMetaTags);
    </script>
  </body>
</html>
