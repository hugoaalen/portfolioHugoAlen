---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";

const navItems_ES = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Formación",
    label: "formacion",
    url: "/#formacion",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
];

const navItems_EN = [
  {
    title: "Experience",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Projects",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Education",
    label: "formacion",
    url: "/#formacion",
  },
  {
    title: "About",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
];

const isAdminRoute = Astro.url.pathname.startsWith("/admin");
const navItems = isAdminRoute
  ? [
      {
        title: "Portfolio",
        label: "portfolio",
        url: "/",
      },
    ]
  : navItems_ES;
---

<header
  class="fixed top-0 left-0 right-0 z-20 flex items-start justify-end w-full max-w-full px-3 mx-auto mt-3 md:left-1/2 md:max-w-2xl md:-translate-x-1/2 md:px-6 lg:max-w-4xl lg:px-8"
  id="header-container"
>
  <nav
    class="relative flex items-center max-w-[calc(100vw-1.5rem)] px-1 text-xs font-bold tracking-wide text-black uppercase border-2 border-black bg-[#c5ff4a] shadow-[5px_5px_0_#111] dark:border-white dark:shadow-[5px_5px_0_#fff] sm:text-sm md:max-w-full md:px-2"
  >
    <button
      id="mobile-menu-toggle"
      class:list={[
        "items-center gap-2 px-2.5 py-2.5 transition hover:bg-black hover:text-white md:hidden",
        isAdminRoute ? "hidden" : "flex",
      ]}
      aria-expanded="false"
      aria-controls="header-links"
    >
      <span class="menu-icon grid gap-1" aria-hidden="true">
        <span class="block w-4 h-0.5 bg-current"></span>
        <span class="block w-4 h-0.5 bg-current"></span>
        <span class="block w-4 h-0.5 bg-current"></span>
      </span>
      <span id="mobile-menu-label">Menú</span>
    </button>

    <div
      id="header-links"
      class:list={[
        "right-0 w-[calc(100vw-1.5rem)] max-w-64 grid-cols-2 gap-1 p-2 top-[calc(100%+0.65rem)] border-2 border-black bg-[#c5ff4a] shadow-[5px_5px_0_#111] dark:border-white dark:shadow-[5px_5px_0_#fff] md:static md:flex md:w-auto md:max-w-none md:p-0 md:border-0 md:shadow-none dark:md:shadow-none",
        isAdminRoute ? "static flex w-auto max-w-none p-0 border-0 shadow-none dark:shadow-none" : "absolute hidden",
      ]}
    >
      {
        navItems.map((link) => (
          <a
            class="relative block px-3 py-3 transition hover:bg-black hover:text-white nav-link md:px-2.5 md:py-2.5"
            aria-label={link.label}
            href={link.url}
            data-label={link.label}
          >
            {link.title}
          </a>
        ))
      }
    </div>

    <div class:list={["w-px h-6 mx-1 bg-black/25 md:hidden", isAdminRoute ? "hidden" : ""]} aria-hidden="true"></div>
    <ThemeToggle />
    {!isAdminRoute && <LanguageToggle />}
  </nav>
</header>

<script is:inline define:vars={{ navItems_ES, navItems_EN }}>
  // El Header es actualizado directamente por LanguageToggle
  // Este script solo maneja el IntersectionObserver para el highlight
  
  document.addEventListener("astro:page-load", () => {
    const cleanupsKey = "__portfolioHeaderCleanups"
    window[cleanupsKey]?.forEach((cleanup) => cleanup())
    window[cleanupsKey] = []
    const addManagedListener = (target, event, handler, options) => {
      target?.addEventListener(event, handler, options)
      window[cleanupsKey]?.push(() => {
        target?.removeEventListener(event, handler, options)
      })
    }

    const menuToggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("header-links");
    const menuLabel = document.getElementById("mobile-menu-label");
    const themesMenu = document.getElementById("themes-menu");
    const themeButton = document.getElementById("theme-toggle-btn");
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a.nav-link");

    const closeMenu = () => {
      menu?.classList.remove("mobile-menu-open");
      themesMenu?.classList.remove("open");
      themeButton?.setAttribute("aria-expanded", "false");
      menuToggle?.setAttribute("aria-expanded", "false");
    };

    addManagedListener(menuToggle, "click", (event) => {
      event.stopPropagation();
      themesMenu?.classList.remove("open");
      themeButton?.setAttribute("aria-expanded", "false");
      const isOpen = menu?.classList.toggle("mobile-menu-open");
      menuToggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    });

    navItems.forEach((item) => addManagedListener(item, "click", closeMenu));
    addManagedListener(document, "click", closeMenu);
    addManagedListener(document, "keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    const updateMenuLabel = () => {
      const lang = localStorage.getItem("language") || "es";
      if (menuLabel) menuLabel.textContent = lang === "en" ? "Menu" : "Menú";
    };

    updateMenuLabel();
    addManagedListener(window, "languageChanged", updateMenuLabel);

    const callback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-yellow-500");
            } else {
              item.classList.remove("text-yellow-500");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });
    window[cleanupsKey]?.push(() => observer.disconnect());

    // Cleanup function
    const handleVisibilityChange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
    addManagedListener(document, "visibilitychange", handleVisibilityChange);
  });
</script>

<style>
  #header-links.mobile-menu-open {
    display: grid;
  }
</style>
