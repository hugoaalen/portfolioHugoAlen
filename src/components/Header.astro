---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";

const navItems_ES = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Formación",
    label: "formacion",
    url: "/#formacion",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
];

const navItems_EN = [
  {
    title: "Experience",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Projects",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Education",
    label: "formacion",
    url: "/#formacion",
  },
  {
    title: "About",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
];

const navItems = navItems_ES;
---

<header
  class="fixed top-0 z-20 flex items-center justify-center w-full px-2 mx-auto mt-3 md:justify-end md:pr-6"
  id="header-container"
>
  <nav
    class="flex max-w-full px-1.5 text-xs font-bold uppercase tracking-wide border-2 border-black text-black justify-center items-center bg-[#c5ff4a] shadow-[5px_5px_0_#111] dark:border-white dark:shadow-[5px_5px_0_#fff] sm:px-2 sm:text-sm"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-1.5 py-2.5 transition hover:bg-black hover:text-white nav-link sm:px-2.5"
          aria-label={link.label}
          href={link.url}
          data-label={link.label}
        >
          {link.title}
        </a>
      ))
    }
    <ThemeToggle />
    <LanguageToggle />
  </nav>
</header>

<script is:inline define:vars={{ navItems_ES, navItems_EN }}>
  // El Header es actualizado directamente por LanguageToggle
  // Este script solo maneja el IntersectionObserver para el highlight
  
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a.nav-link");

    const callback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-yellow-500");
            } else {
              item.classList.remove("text-yellow-500");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>
