---
import LinkInline from "./LinkInline.astro";

// 1. Actualizamos la interfaz para que TypeScript sepa que ahora recibimos objetos con idiomas
interface I18nText {
  es: string;
  en: string;
}

interface Props {
  title: I18nText;
  company: string;
  description: I18nText;
  link?: string;
  date: I18nText;
}

const { title, company, description, link, date } = Astro.props;
---

<div
  class="relative grid h-full gap-5 p-6 transition border-2 border-black bg-white shadow-[7px_7px_0_#111] hover:-translate-y-1 dark:border-white dark:bg-[#111] dark:shadow-[7px_7px_0_#c5ff4a]"
>
  <div class="relative">
    <div>
      <h3 
        class="text-xl font-black leading-tight text-black uppercase dark:text-[#c5ff4a] i18n"
        data-es={title.es}
        data-en={title.en}
      >
        {title.es}
      </h3>
      
      <h4 class="mt-2 text-lg font-bold text-gray-800 dark:text-white">
        {company}
      </h4>
      
      <time 
        class="inline-block p-1 mt-3 text-xs font-black tracking-wide text-black uppercase bg-[#c5ff4a] i18n"
        data-es={date.es}
        data-en={date.en}
      >
        {date.es}
      </time>
    </div>
  </div>
  
  <div
    class="relative flex flex-col gap-2 pt-5 leading-relaxed text-gray-700 border-t-2 border-black dark:border-white dark:text-gray-300"
  >
    <div 
      class="text-pretty i18n"
      data-es={description.es}
      data-en={description.en}
    >
      {description.es}
    </div>
    
    {
      link && (
        <LinkInline href={link}>
          <span class="i18n" data-es="Saber más" data-en="Learn more">Saber más</span>{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
