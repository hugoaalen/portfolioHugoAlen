---
import SunIcon from "./icons/Sun.astro"
import MoonIcon from "./icons/Moon.astro"
import SystemIcon from "./icons/System.astro"

const THEMES = ["Light", "Dark", "System"]
---

<div id="theme-toggle-root" class="relative ml-1 mr-1">
  <button
    id="theme-toggle-btn"
    type="button"
    aria-expanded="false"
    class="flex p-2 text-black transition appearance-none border-none hover:bg-black hover:text-white"
  >
    <span class="sr-only">Elige el tema</span>
    <SunIcon id="light" class="theme-toggle-icon size-5 transition-all" />
    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
  </button>
  <div
    id="themes-menu"
    class="absolute z-50 hidden scale-80 top-10 right-0 text-sm font-black uppercase p-2 min-w-[8rem] border-2 border-black bg-white text-black dark:bg-[#111] dark:text-white dark:border-white shadow-[5px_5px_0_#111] dark:shadow-[5px_5px_0_#c5ff4a]"
  >
    <ul>
      {
        THEMES.map((theme) => (
          <li class="themes-menu-option px-3 py-2 cursor-pointer hover:bg-[#c5ff4a] hover:text-black">
            {theme}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: block;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  (() => {
    const cleanupsKey = "__portfolioThemeToggleCleanups";

    const initializeThemeToggle = () => {
      window[cleanupsKey]?.forEach((cleanup) => cleanup());
      window[cleanupsKey] = [];

      const addManagedListener = (target, event, handler, options) => {
        target?.addEventListener(event, handler, options);
        window[cleanupsKey]?.push(() => {
          target?.removeEventListener(event, handler, options);
        });
      };

      const matchMedia = window.matchMedia("(prefers-color-scheme: dark)");
      const themesMenu = document.getElementById("themes-menu");
      const themeButton = document.getElementById("theme-toggle-btn");
      if (!themesMenu || !themeButton) return;

      const getThemePreference = () => {
        return localStorage.getItem("theme") ?? "system";
      };

      const updateIcon = (themePreference) => {
        document.querySelectorAll(".theme-toggle-icon").forEach((element) => {
          element.style.scale = element.id === themePreference ? "1" : "0";
        });
      };

      const updateTheme = () => {
        const themePreference = getThemePreference();
        const isDark =
          themePreference === "dark" ||
          (themePreference === "system" && matchMedia.matches);

        updateIcon(themePreference);
        document.documentElement.classList[isDark ? "add" : "remove"]("dark");
      };

      const closeThemesMenu = () => {
        themesMenu.classList.remove("open");
        themeButton.setAttribute("aria-expanded", "false");
      };

      addManagedListener(matchMedia, "change", updateTheme);
      addManagedListener(document, "click", closeThemesMenu);
      addManagedListener(window, "hashchange", closeThemesMenu);
      addManagedListener(document, "astro:before-swap", closeThemesMenu);

      addManagedListener(themeButton, "click", (event) => {
        event.stopPropagation();
        const isClosed = !themesMenu.classList.contains("open");
        themesMenu.classList[isClosed ? "add" : "remove"]("open");
        themeButton.setAttribute("aria-expanded", String(isClosed));
      });

      document.querySelectorAll(".themes-menu-option").forEach((element) => {
        addManagedListener(element, "click", (event) => {
          localStorage.setItem(
            "theme",
            event.currentTarget.innerText.toLowerCase().trim(),
          );
          updateTheme();
          closeThemesMenu();
        });
      });

      updateTheme();
    };

    initializeThemeToggle();
    document.addEventListener("astro:page-load", initializeThemeToggle);
  })();
</script>
