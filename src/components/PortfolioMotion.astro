<script>
  import "@/styles/portfolio-hover.css";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initializePortfolioHover } from "@/lib/portfolio-hover";

  gsap.registerPlugin(ScrollTrigger);
  let activeRoot: HTMLElement | null = null;
  let cleanup: (() => void) | undefined;

  function initializeMotion() {
    const root = document.querySelector<HTMLElement>('body[data-page="portfolio"]');
    if (root === activeRoot) return;
    cleanup?.();
    activeRoot = root;
    if (!root) return;
    const disposeHover = initializePortfolioHover(root);

    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      let disposed = false;
      let refreshFrame = 0;
      const seen = new WeakSet<Element>();
      const heroWords = Array.from(root.querySelectorAll<HTMLElement>("#hero-title .hero-word"));
      const animateSheen = (delay = 0.6) => {
        gsap.killTweensOf("#hero-desc1 strong");
        gsap.fromTo("#hero-desc1 strong", { backgroundPosition: "100% 0%" }, {
          backgroundPosition: "0% 0%",
          duration: 2.2,
          ease: "sine.inOut",
          repeat: -1,
          repeatDelay: 1.8,
          delay,
        });
      };
      const context = gsap.context(() => {
        const tl = gsap.timeline({ defaults: { duration: 0.75, ease: "power3.out" } })
          .from(".hero-panel > header", { y: 16, autoAlpha: 0, clearProps: "transform,opacity,visibility" });

        if (heroWords.length > 0) {
          gsap.set("#hero-title .hero-word-mask", { overflow: "hidden" });
          tl.from(heroWords, {
            yPercent: 115,
            rotateX: -22,
            autoAlpha: 0,
            duration: 0.85,
            stagger: 0.08,
            ease: "power4.out",
            clearProps: "transform,opacity,visibility",
            onComplete: () => { gsap.set("#hero-title .hero-word-mask", { clearProps: "overflow" }); },
          }, "-=0.45");
        } else {
          tl.from("#hero-title", { y: 40, autoAlpha: 0, duration: 0.85, clearProps: "transform,opacity,visibility" }, "-=0.45");
        }

        tl.from(["#hero-desc1", "#hero-desc2", ".hero-panel > nav"], {
          y: 20, autoAlpha: 0, stagger: 0.1, clearProps: "transform,opacity,visibility",
        }, "-=0.5");

        animateSheen(0.6);

        gsap.from(".hero-symbol-orbit", {
          rotation: -60, transformOrigin: "50% 50%", duration: 1.6, ease: "power2.out",
        });
        gsap.to(".hero-symbol", {
          rotation: 45, ease: "none",
          scrollTrigger: { trigger: "#hero", start: "top top", end: "bottom top", scrub: 0.8 },
        });
      }, root);

      const onLanguageChange = () => {
        requestAnimationFrame(() => {
          if (!disposed) {
            context.add(() => animateSheen(0.4));
          }
        });
      };

      const refresh = () => {
        cancelAnimationFrame(refreshFrame);
        refreshFrame = requestAnimationFrame(() => {
          if (!disposed) ScrollTrigger.refresh();
        });
      };

      const revealNewContent = () => {
        context.add(() => {
          root.querySelectorAll(".section-title, .project-card, #experience-container > li, #education-container li, #about-container, .footer-invitation")
            .forEach((element) => {
              if (seen.has(element)) return;
              seen.add(element);
              gsap.from(element, {
                y: 28, opacity: 0.35, duration: 0.7, ease: "power2.out",
                clearProps: "transform,opacity",
                scrollTrigger: { trigger: element, start: "top 94%", once: true },
              });
            });
        });
        refresh();
      };

      revealNewContent();
      // Firestore replaces cards after initial render; register the new elements too.
      const observer = new MutationObserver(revealNewContent);
      const content = root.querySelector("#main-sections");
      if (content) observer.observe(content, { childList: true, subtree: true });
      root.addEventListener("load", refresh, true);
      window.addEventListener("languageChanged", onLanguageChange);
      document.fonts.ready.then(() => { if (!disposed) refresh(); });

      return () => {
        disposed = true;
        cancelAnimationFrame(refreshFrame);
        observer.disconnect();
        root.removeEventListener("load", refresh, true);
        window.removeEventListener("languageChanged", onLanguageChange);
        context.revert();
      };
    });
    cleanup = () => { disposeHover(); media.revert(); activeRoot = null; };
  }

  initializeMotion();
  document.addEventListener("astro:page-load", initializeMotion);
  document.addEventListener("astro:before-swap", () => { cleanup?.(); cleanup = undefined; });
</script>
