---
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import GitHub from "@/components/icons/GitHub.astro";
import DownloadIcon from "@/components/icons/Download.astro";
import SocialPill from "@/components/SocialPill.astro";
import { profile } from "@/data/content";
import { getOptimizedImagePath } from "@/lib/public-assets";

const { hero, social } = profile;
---

<div class="relative max-w-5xl" id="hero-content">
  <div class="hero-panel relative z-10 p-6 border-2 border-black bg-white/90 shadow-[10px_10px_0_#111] dark:border-white dark:bg-[#111] dark:shadow-[10px_10px_0_var(--p-accent,#a7bcd9)] sm:p-9">
    <header class="flex flex-col gap-5 pb-6 mb-7 border-b-2 border-black dark:border-white sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <img
          id="hero-profile-image"
          class="object-cover border-2 border-black rounded-full shadow-[4px_4px_0_#111] size-20 dark:border-white dark:shadow-[4px_4px_0_var(--p-accent,#a7bcd9)]"
          src={getOptimizedImagePath(profile.image)}
          alt={profile.imageAlt}
          width="256"
          height="255"
          decoding="async"
          fetchpriority="high"
        />
        <div>
          <p id="hero-name" class="text-lg font-black leading-none text-black dark:text-white">{profile.name}</p>
          <p id="hero-kicker" class="mt-2 text-[10px] font-black tracking-[0.14em] text-black uppercase dark:text-[var(--p-accent,#a7bcd9)] sm:text-xs sm:tracking-[0.18em]">
            {profile.kicker}
          </p>
          <p id="hero-location" class="mt-1.5 text-xs font-black tracking-[0.2em] text-gray-600 uppercase dark:text-gray-400">
            {profile.location}
          </p>
        </div>
      </div>

      <a
        id="hero-badge-link"
        href={social.linkedin}
        target="_blank"
        rel="noopener"
        class="flex items-center transition hover:-translate-y-1 sm:justify-end"
      >
        <Badge>
          <span class="i18n" id="badge-available" data-es={hero.badge.es} data-en={hero.badge.en}>
            {hero.badge.es}
          </span>
        </Badge>
      </a>
    </header>

    <svg class="hero-symbol" viewBox="0 0 320 320" fill="none" aria-hidden="true">
      <g class="hero-symbol-orbit" stroke="currentColor" stroke-width="1.5">
        <circle cx="160" cy="160" r="140" />
        <ellipse cx="160" cy="160" rx="65" ry="140" />
        <ellipse cx="160" cy="160" rx="140" ry="65" />
        <path d="M20 160h280M160 20v280M61 61l198 198M61 259 259 61" />
      </g>
      <circle cx="160" cy="20" r="7" fill="currentColor" />
    </svg>

    <h1
      class="max-w-4xl text-[2.6rem] font-black leading-[0.9] tracking-[-0.055em] text-black uppercase sm:text-6xl md:text-[4.8rem] dark:text-white i18n"
      id="hero-title"
      data-es={hero.title.es}
      data-en={hero.title.en}
    >
      {hero.title.es}
    </h1>

    <div class="grid gap-5 mt-8 md:grid-cols-[1.05fr_0.95fr] md:gap-10">
      <p
        class="text-xl font-medium leading-relaxed text-gray-800 [&>strong]:bg-[var(--p-accent,#a7bcd9)] [&>strong]:px-1 [&>strong]:text-[var(--p-accent-ink,#17202b)] [&>strong]:font-bold dark:text-gray-200 md:text-2xl i18n-html"
        id="hero-desc1"
        data-es={hero.description[0].es}
        data-en={hero.description[0].en}
        set:html={hero.description[0].es}
      />
      <p
        class="text-base leading-relaxed text-gray-700 dark:[&>strong]:text-[var(--p-accent,#a7bcd9)] [&>strong]:font-bold dark:text-gray-300 sm:text-lg i18n-html"
        id="hero-desc2"
        data-es={hero.description[1].es}
        data-en={hero.description[1].en}
        set:html={hero.description[1].es}
      />
    </div>

    <nav class="flex flex-wrap gap-3 mt-9">
    <a href="#proyectos" class="hero-project-link">
      <span class="i18n" data-es="Explorar proyectos" data-en="Explore projects">Explorar proyectos</span>
      <span aria-hidden="true">↗</span>
    </a>
    <SocialPill href={`mailto:${profile.email}`} id="hero-email-link">
      <MailIcon class="size-4" />
      <span class="hero-action-label i18n" id="btn-contact" data-es={hero.buttons.contact.es} data-en={hero.buttons.contact.en}>
        {hero.buttons.contact.es}
      </span>
    </SocialPill>
    <SocialPill href="/CV-Hugo-Alen.pdf" download="CV-Hugo-Alen.pdf" id="hero-cv-link">
      <DownloadIcon class="size-4" />
      <span class="hero-action-label i18n" id="btn-cv" data-es={hero.buttons.cv.es} data-en={hero.buttons.cv.en}>
        {hero.buttons.cv.es}
      </span>
    </SocialPill>
    <SocialPill
      id="hero-linkedin-link"
      href={social.linkedin}
    >
      <LinkedInIcon class="size-4" />
      <span class="hero-action-label">LinkedIn</span>
    </SocialPill>
    <SocialPill href={social.github} id="hero-github-link">
      <GitHub class="size-4" />
      <span class="hero-action-label">GitHub</span>
    </SocialPill>
    </nav>
  </div>
</div>

<script>

  function updateLanguage() {
    const lang = localStorage.getItem('language') || 'es';

    document.querySelectorAll('.i18n').forEach((el) => {
      const translation = el.getAttribute(`data-${lang}`);
      if (translation) el.textContent = translation;
    });

    document.querySelectorAll('.i18n-html').forEach((el) => {
      const translation = el.getAttribute(`data-${lang}`);
      if (translation) el.innerHTML = translation;
    });
  }


  updateLanguage();
  window.addEventListener('languageChanged', updateLanguage);
</script>
