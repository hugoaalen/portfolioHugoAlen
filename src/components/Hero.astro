---
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import GitHub from "@/components/icons/GitHub.astro";
import SocialPill from "@/components/SocialPill.astro";
import { profile } from "@/data/content";

const { hero, social } = profile;
---

<div class="relative max-w-5xl" id="hero-content">
  <div class="relative z-10 p-6 border-2 border-black bg-white/90 shadow-[10px_10px_0_#111] dark:border-white dark:bg-[#111] dark:shadow-[10px_10px_0_#c5ff4a] sm:p-9">
    <header class="flex flex-col gap-5 pb-6 mb-7 border-b-2 border-black dark:border-white sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <img
          id="hero-profile-image"
          class="object-cover border-2 border-black rounded-full shadow-[4px_4px_0_#111] size-20 dark:border-white dark:shadow-[4px_4px_0_#c5ff4a]"
          src={profile.image}
          alt={profile.imageAlt}
        />
        <div>
          <p id="hero-kicker" class="text-[10px] font-black tracking-[0.18em] text-black uppercase dark:text-[#c5ff4a] sm:text-xs sm:tracking-[0.24em]">
            {profile.kicker}
          </p>
          <p id="hero-location" class="mt-2 text-xs font-black tracking-[0.2em] text-gray-600 uppercase dark:text-gray-400">
            {profile.location}
          </p>
        </div>
      </div>

      <a
        id="hero-badge-link"
        href={social.linkedin}
        target="_blank"
        rel="noopener"
        class="flex items-center transition hover:-translate-y-1 sm:justify-end"
      >
        <Badge>
          <span class="i18n" id="badge-available" data-es={hero.badge.es} data-en={hero.badge.en}>
            {hero.badge.es}
          </span>
        </Badge>
      </a>
    </header>

    <h1
      class="max-w-4xl text-5xl font-black leading-[0.9] tracking-[-0.07em] text-black uppercase sm:text-7xl md:text-[5.8rem] dark:text-white i18n"
      id="hero-title"
      data-es={hero.title.es}
      data-en={hero.title.en}
    >
      {hero.title.es}
    </h1>

    <div class="grid gap-5 mt-8 md:grid-cols-[0.8fr_1.2fr] md:gap-10">
      <p
        class="text-xl font-medium leading-relaxed text-gray-800 [&>strong]:bg-[#c5ff4a] [&>strong]:px-1 [&>strong]:text-black [&>strong]:font-bold dark:text-gray-200 md:text-2xl i18n-html"
        id="hero-desc1"
        data-es={hero.description[0].es}
        data-en={hero.description[0].en}
        set:html={hero.description[0].es}
      />
      <p
        class="text-base leading-relaxed text-gray-600 dark:[&>strong]:text-[#c5ff4a] [&>strong]:font-bold dark:text-gray-400 sm:text-lg i18n-html"
        id="hero-desc2"
        data-es={hero.description[1].es}
        data-en={hero.description[1].en}
        set:html={hero.description[1].es}
      />
    </div>

    <nav class="flex flex-wrap gap-3 mt-9">
    <!--
    <SocialPill href="/CV-Hugo-Alen.pdf" download="CV-Hugo-Alen.pdf">
      <DownloadIcon class="size-4" />
      <span id="btn-cv">Descargar CV</span>
    </SocialPill>
    -->
    <SocialPill href={`mailto:${profile.email}`} id="hero-email-link">
      <MailIcon class="size-4" />
      <span class="i18n" id="btn-contact" data-es={hero.buttons.contact.es} data-en={hero.buttons.contact.en}>
        {hero.buttons.contact.es}
      </span>
    </SocialPill>
    <SocialPill
      id="hero-linkedin-link"
      href={social.linkedin}
    >
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href={social.github} id="hero-github-link">
      <GitHub class="size-4" />
      Github
    </SocialPill>
    </nav>
  </div>
</div>

<script>
  import { doc, getDoc } from "firebase/firestore";
  import { db } from "@/lib/firebase";

  function updateLanguage() {
    const lang = localStorage.getItem('language') || 'es';

    document.querySelectorAll('.i18n').forEach((el) => {
      const translation = el.getAttribute(`data-${lang}`);
      if (translation) el.textContent = translation;
    });

    document.querySelectorAll('.i18n-html').forEach((el) => {
      const translation = el.getAttribute(`data-${lang}`);
      if (translation) el.innerHTML = translation;
    });
  }

  async function hydrateProfileFromFirestore() {
    try {
      const snapshot = await getDoc(doc(db, "content", "profile"));
      if (!snapshot.exists()) return;

      const profile = snapshot.data();
      const hero = profile.hero ?? {};
      const social = profile.social ?? {};
      const image = document.getElementById("hero-profile-image") as HTMLImageElement | null;
      const kicker = document.getElementById("hero-kicker");
      const location = document.getElementById("hero-location");
      const badge = document.getElementById("badge-available");
      const title = document.getElementById("hero-title");
      const desc1 = document.getElementById("hero-desc1");
      const desc2 = document.getElementById("hero-desc2");
      const contact = document.getElementById("btn-contact");
      const emailLink = document.getElementById("hero-email-link") as HTMLAnchorElement | null;
      const badgeLink = document.getElementById("hero-badge-link") as HTMLAnchorElement | null;
      const linkedInLink = document.getElementById("hero-linkedin-link") as HTMLAnchorElement | null;
      const githubLink = document.getElementById("hero-github-link") as HTMLAnchorElement | null;

      if (image && typeof profile.image === "string") image.src = profile.image;
      if (image && typeof profile.imageAlt === "string") image.alt = profile.imageAlt;
      if (kicker && typeof profile.kicker === "string") kicker.textContent = profile.kicker;
      if (location && typeof profile.location === "string") location.textContent = profile.location;
      if (emailLink && typeof profile.email === "string") emailLink.href = `mailto:${profile.email}`;
      if (badgeLink && typeof social.linkedin === "string") badgeLink.href = social.linkedin;
      if (linkedInLink && typeof social.linkedin === "string") linkedInLink.href = social.linkedin;
      if (githubLink && typeof social.github === "string") githubLink.href = social.github;

      const i18nTargets = [
        [badge, hero.badge],
        [title, hero.title],
        [contact, hero.buttons?.contact],
      ] as const;

      i18nTargets.forEach(([element, value]) => {
        if (!element || !value?.es || !value?.en) return;
        element.setAttribute("data-es", value.es);
        element.setAttribute("data-en", value.en);
      });

      [desc1, desc2].forEach((element, index) => {
        const value = hero.description?.[index];
        if (!element || !value?.es || !value?.en) return;
        element.setAttribute("data-es", value.es);
        element.setAttribute("data-en", value.en);
      });

      updateLanguage();
    } catch (error) {
      console.error("No se pudo cargar el perfil desde Firestore.", error);
    }
  }

  updateLanguage();
  hydrateProfileFromFirestore();
  window.addEventListener('languageChanged', updateLanguage);
</script>
