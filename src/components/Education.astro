---
import EducationItem from "./EducationItem.astro";
import { education } from "@/data/content";
import { groupEducation } from "@/lib/education-groups";

const { primary: primaryEducation, additional: additionalEducation } = groupEducation(education);
---

<div id="education-container">
  <ol class="grid gap-4 md:grid-cols-2">
    {
      primaryEducation.map((item) => (
        <li>
          <EducationItem {...item} />
        </li>
      ))
    }
  </ol>

  {
    additionalEducation.length > 0 && (
      <section class="mt-10" aria-labelledby="additional-education-title">
        <h3
          id="additional-education-title"
          class="mb-5 text-sm font-black tracking-[0.16em] text-gray-700 uppercase dark:text-gray-300 i18n"
          data-es="Certificaciones y formación adicional"
          data-en="Certifications and additional training"
        >
          Certificaciones y formación adicional
        </h3>
        <ol class="grid gap-4 sm:grid-cols-2">
          {additionalEducation.map((item) => (
            <li>
              <EducationItem {...item} variant="secondary" />
            </li>
          ))}
        </ol>
      </section>
    )
  }
</div>

<script>
  import { collection, getDocs, query, where } from "firebase/firestore/lite";
  import { publicDb } from "@/lib/firebase-public";
  import { renderOrganizationLogo } from "@/lib/organization-logo";
  import { groupEducation } from "@/lib/education-groups";

  function updateEducationLanguage() {
    const lang = localStorage.getItem('language') || 'es';
    const container = document.getElementById('education-container');

    if (!container) return;

    const elements = container.querySelectorAll('.i18n');

    elements.forEach((el) => {
      const translation = el.getAttribute(`data-${lang}`);
      if (translation) {
        el.textContent = translation;
      }
    });
	  }

	  function escapeHtml(value: unknown) {
	    return String(value ?? "")
	      .replaceAll("&", "&amp;")
	      .replaceAll("<", "&lt;")
	      .replaceAll(">", "&gt;")
	      .replaceAll('"', "&quot;")
	      .replaceAll("'", "&#039;");
	  }

	  function renderEducationItem(item: any, variant: "primary" | "secondary") {
	    const isPrimary = variant === "primary";
	    const cardClass = isPrimary
	      ? "p-6 bg-[#c5ff4a]"
	      : "p-5 bg-white dark:bg-[#111] dark:shadow-[7px_7px_0_#c5ff4a]";
	    const titleClass = isPrimary ? "text-lg text-black" : "text-base text-black dark:text-white";
	    const companyClass = isPrimary ? "text-gray-800" : "text-gray-700 dark:text-gray-300";
	    const dateClass = isPrimary ? "text-white bg-black" : "text-black bg-[#c5ff4a]";
	    const link = item.link
	      ? `<a href="${escapeHtml(item.link)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-semibold underline decoration-black decoration-2 underline-offset-4">
	          <span class="i18n" data-es="Saber más" data-en="Learn more">Saber más</span>
	          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 icon icon-tabler icon-tabler-chevron-right" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
	            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
	            <path d="M9 6l6 6l-6 6" />
	          </svg>
	        </a>`
	      : "";

	    return `
	      <li>
	        <div class="relative h-full ${cardClass} transition border-2 border-black shadow-[7px_7px_0_#111] hover:-translate-y-1 dark:border-white">
	          <div class="organization-heading relative">
                ${renderOrganizationLogo(String(item.company ?? ""))}
	            <div>
	              <h3 class="${titleClass} font-black leading-tight uppercase i18n" data-es="${escapeHtml(item.title?.es)}" data-en="${escapeHtml(item.title?.en)}">
	                ${escapeHtml(item.title?.es)}
	              </h3>
	              <h4 class="mt-2 font-bold ${companyClass}">
	                <span>${escapeHtml(item.company)}</span>
	              </h4>
	              <time class="inline-block p-1 mt-4 text-xs font-black tracking-wide uppercase ${dateClass} i18n" data-es="${escapeHtml(item.date?.es)}" data-en="${escapeHtml(item.date?.en)}">
	                ${escapeHtml(item.date?.es)}
	              </time>
	            </div>
	          </div>
	          <div class="relative flex flex-col gap-2 text-gray-700">
	            ${link}
	          </div>
	        </div>
	      </li>
	    `;
	  }

	  function renderEducationGroups(items: any[]) {
	    const { primary, additional } = groupEducation(items);
	    const additionalSection = additional.length > 0
	      ? `<section class="mt-10" aria-labelledby="additional-education-title">
	          <h3 id="additional-education-title" class="mb-5 text-sm font-black tracking-[0.16em] text-gray-700 uppercase dark:text-gray-300 i18n" data-es="Certificaciones y formación adicional" data-en="Certifications and additional training">Certificaciones y formación adicional</h3>
	          <ol class="grid gap-4 sm:grid-cols-2">
	            ${additional.map((item) => renderEducationItem(item, "secondary")).join("")}
	          </ol>
	        </section>`
	      : "";

	    return `<ol class="grid gap-4 md:grid-cols-2">${primary.map((item) => renderEducationItem(item, "primary")).join("")}</ol>${additionalSection}`;
	  }

	  async function hydrateEducationFromFirestore() {
	    try {
	      const container = document.getElementById("education-container");
	      if (!container) return;

	      const snapshot = await getDocs(query(collection(publicDb, "education"), where("visible", "==", true)));
	      const items = snapshot.docs
	        .map((item) => { const data = item.data(); return { ...data, id: String(data.id ?? item.id), order: Number(data.order ?? 0) }; })
	        .sort((a, b) => Number(a.order ?? 0) - Number(b.order ?? 0));
	      if (items.length === 0) return;

	      container.innerHTML = renderEducationGroups(items);
	      updateEducationLanguage();
	    } catch (error) {
	      console.error("No se pudo cargar Formación desde Firestore.", error);
	    }
	  }

	  updateEducationLanguage();
	  hydrateEducationFromFirestore();
	  window.addEventListener('languageChanged', updateEducationLanguage);
	</script>
