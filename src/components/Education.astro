---
import EducationItem from "./EducationItem.astro";
import { education } from "@/data/content";
---

<ol class="grid gap-4 md:grid-cols-2" id="education-container">
  {
    education.map((item) => (
      <li class="">
        <EducationItem {...item} />
      </li> 
    ))
  }
</ol>

<script>
  function updateEducationLanguage() {
    const lang = localStorage.getItem('language') || 'es';
    const container = document.getElementById('education-container');
    
    if (!container) return;

    const elements = container.querySelectorAll('.i18n');

    elements.forEach((el) => {
      const translation = el.getAttribute(`data-${lang}`);
      if (translation) {
        el.textContent = translation;
      }
    });
  }
  
  updateEducationLanguage();
  window.addEventListener('languageChanged', updateEducationLanguage);
</script>
