---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import HTML from "./icons/Html.astro";
import CSS from "./icons/Css.astro";
import VanillaJS from "./icons/VanillaJS.astro";
import Bootstrap from "./icons/Bootstrap.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  HTML: {
    name: "HTML",
    class: "bg-[#E34F2680] text-white",
    icon: HTML,
  },
  CSS: {
    name: "CSS",
    class: "bg-[#264DE480] text-white",
    icon: CSS,
  },
  VANILLAJS: {
    name: "VanillaJS",
    class: "bg-[#F7DF1E80] text-white",
    icon: VanillaJS,
  },
  BOOTSTRAP: {
    name: "Bootstrap",
    class: "bg-[#7952B380] text-white",
    icon: Bootstrap,
  },
};

const PROJECTS_ES = [
  {
    title: "BPKeepers - Mentoría y entrenamientos de porteros",
    description:
      "Web de la escuela de porteros de Brais Pereiro, BPKeepers. Entrenamientos para porteros de todas las edades y niveles.",
    link: "https://bpkeepers.com",
    github: "https://github.com/alacdev/bpkeepers",
    image: "/projects/bpkeepers.webp",
    tags: [TAGS.HTML, TAGS.CSS],
  },
  {
    title: "TothallyLearning - Cursos en línea y presenciales",
    description:
      "Plataforma de cursos de todo tipo, con cursos presenciales y online. Cursos de tecnología, acondicionamiento físico, nutrición, diseño... y mucho más",
    link: "",
    github: "",
    image: "/projects/tothallylearning.webp",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.VANILLAJS, TAGS.BOOTSTRAP],
  },
];

const PROJECTS_EN = [
  {
    title: "BPKeepers - Coaching and goalkeeper training",
    description:
      "Website of Brais Pereiro's goalkeeper school, BPKeepers. Training for goalkeepers of all ages and levels.",
    link: "https://bpkeepers.com",
    github: "https://github.com/alacdev/bpkeepers",
    image: "/projects/bpkeepers.webp",
    tags: [TAGS.HTML, TAGS.CSS],
  },
  {
    title: "TothallyLearning - Online and in-person courses",
    description:
      "Courses platform of all kinds, with in-person and online courses. Technology, fitness, nutrition, design courses... and much more",
    link: "",
    github: "",
    image: "/projects/tothallylearning.webp",
    tags: [TAGS.HTML, TAGS.CSS, TAGS.VANILLAJS, TAGS.BOOTSTRAP],
  },
];

const PROJECTS = PROJECTS_ES;
---

<div class="flex flex-col gap-y-16" id="projects-container">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt="Imagen no disponible"
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100 project-title">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400 project-desc">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github} class="code-btn">
                  <GitHub class="size-6" />
                  <span class="code-text">Code</span>
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link} class="preview-btn">
                  <Link class="size-4" />
                  <span class="preview-text">Preview</span>
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>

<script define:vars={{ PROJECTS_ES: JSON.stringify(PROJECTS_ES), PROJECTS_EN: JSON.stringify(PROJECTS_EN) }}>
  function updateProjectsLanguage() {
    const lang = localStorage.getItem('language') || 'es';
    const projects = lang === 'en' ? JSON.parse(PROJECTS_EN) : JSON.parse(PROJECTS_ES);
    const container = document.getElementById('projects-container');
    
    if (!container) return;
    
    const articles = container.querySelectorAll('article');
    articles.forEach((article, index) => {
      const project = projects[index];
      if (!project) return;
      
      // Actualizar título
      const titleEl = article.querySelector('.project-title');
      if (titleEl) titleEl.textContent = project.title;
      
      // Actualizar descripción
      const descEl = article.querySelector('.project-desc');
      if (descEl) descEl.textContent = project.description;
      
      // Actualizar botón Code
      const codeText = article.querySelector('.code-text');
      if (codeText) codeText.textContent = lang === 'en' ? 'Code' : 'Código';
      
      // Actualizar botón Preview
      const previewText = article.querySelector('.preview-text');
      if (previewText) previewText.textContent = lang === 'en' ? 'Preview' : 'Vista previa';
    });
  }
  
  updateProjectsLanguage();
  window.addEventListener('languageChanged', updateProjectsLanguage);
</script>
