---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import HTML from "./icons/Html.astro";
import CSS from "./icons/Css.astro";
import VanillaJS from "./icons/VanillaJS.astro";
import Bootstrap from "./icons/Bootstrap.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import React from "./icons/React.astro";
import Supabase from "./icons/Supabase.astro";
import AstroIcon from "./icons/LogoAstro.astro";
import Vite from "./icons/Vite.astro";
import TypeScript from "./icons/TypeScript.astro";
import Firebase from "./icons/Firebase.astro";
import PHP from "./icons/PHP.astro";
import Angular from "./icons/Angular.astro";
import MySQL from "./icons/MySQL.astro";
import Java from "./icons/Java.astro";
import Bash from "./icons/Bash.astro";
import CSharp from "./icons/CSharp.astro";
import Docker from "./icons/Docker.astro";
import DotNet from "./icons/DotNet.astro";
import Express from "./icons/Express.astro";
import NodeJS from "./icons/NodeJS.astro";
import PostgreSQL from "./icons/PostgreSQL.astro";
import Python from "./icons/Python.astro";
import SQLite from "./icons/SQLite.astro";
import SqlServer from "./icons/SqlServer.astro";
import { projects } from "@/data/content";

const TAGS = {
  NEXT: { name: "Next.js", class: "bg-black text-white", icon: NextJS, iconColor: "#000000" },
  TAILWIND: { name: "Tailwind CSS", class: "bg-[#003159] text-white", icon: Tailwind, iconColor: "#38BDF8" },
  HTML: { name: "HTML", class: "bg-[#E34F2680] text-white", icon: HTML, iconColor: "#E34F26" },
  CSS: { name: "CSS", class: "bg-[#264DE480] text-white", icon: CSS, iconColor: "#1572B6" },
  VANILLAJS: { name: "VanillaJS", class: "bg-[#F7DF1E80] text-white", icon: VanillaJS, iconColor: "#F7DF1E" },
  BOOTSTRAP: { name: "Bootstrap", class: "bg-[#7952B380] text-white", icon: Bootstrap, iconColor: "#7952B3" },
  REACT: { name: "React", class: "bg-[#003159] text-white", icon: React, iconColor: "#61DAFB" },
  SUPABASE: { name: "Supabase", class: "bg-[#1C3F2E] text-white", icon: Supabase, iconColor: "#3ECF8E" },
  ASTRO: { name: "Astro", class: "bg-[#E34F2680] text-white", icon: AstroIcon, iconColor: "#FF5D01" },
  VITE: { name: "Vite", class: "bg-[#646CFF] text-white", icon: Vite, iconColor: "#646CFF" },
  TYPESCRIPT: { name: "TypeScript", class: "bg-[#3178C6] text-white", icon: TypeScript, iconColor: "#3178C6" },
  FIREBASE: { name: "Firebase", class: "bg-[#FFCA28] text-black", icon: Firebase, iconColor: "#FFCA28" },
  PHP: { name: "PHP", class: "bg-[#777BB4] text-white", icon: PHP, iconColor: "#777BB4" },
  ANGULAR: { name: "Angular", class: "bg-[#C3002F] text-white", icon: Angular, iconColor: "#DD0031" },
  MYSQL: { name: "MySQL", class: "bg-[#00546B] text-white", icon: MySQL, iconColor: "#00758F" },
  NODE: { name: "Node.js", class: "bg-[#2F6B2F] text-white", icon: NodeJS, iconColor: "#3C873A" },
  EXPRESS: { name: "Express", class: "bg-black text-white", icon: Express, iconColor: "#000000" },
  PYTHON: { name: "Python", class: "bg-[#3776AB] text-white", icon: Python, iconColor: "#3776AB" },
  DOCKER: { name: "Docker", class: "bg-[#2496ED] text-white", icon: Docker, iconColor: "#2496ED" },
  POSTGRESQL: { name: "PostgreSQL", class: "bg-[#336791] text-white", icon: PostgreSQL, iconColor: "#336791" },
  SQLSERVER: { name: "SQL Server", class: "bg-[#A91D22] text-white", icon: SqlServer, iconColor: "#CC2927" },
  DOTNET: { name: ".NET", class: "bg-[#512BD4] text-white", icon: DotNet, iconColor: "#512BD4" },
  CSHARP: { name: "C#", class: "bg-[#68217A] text-white", icon: CSharp, iconColor: "#68217A" },
  BASH: { name: "Bash", class: "bg-[#293137] text-white", icon: Bash, iconColor: "#293137" },
  JAVA: { name: "Java", class: "bg-[#E76F00] text-white", icon: Java, iconColor: "#E76F00" },
  SQLITE: { name: "SQLite", class: "bg-[#003B57] text-white", icon: SQLite, iconColor: "#003B57" },
};

const PROJECTS = projects.map((project) => ({
  ...project,
  tags: project.tags
    .map((tag) => TAGS[tag as keyof typeof TAGS])
    .filter(Boolean),
}));
---

<div class="grid gap-7 md:grid-cols-2" id="projects-container">
  {
    PROJECTS.map(({ image, title, description, tags, link, github, featured }) => (
      <article class:list={[
        "project-card flex flex-col overflow-hidden transition duration-200 border-2 border-black bg-white shadow-[8px_8px_0_#111] group hover:-translate-y-1 hover:shadow-[12px_12px_0_#111] dark:border-white dark:bg-[#111] dark:shadow-[8px_8px_0_#c5ff4a] dark:hover:shadow-[12px_12px_0_#c5ff4a]",
        { "project-card-featured": featured },
      ]}>
        <div class="w-full">
          <div class="relative flex flex-col items-center overflow-hidden">
            <img
              alt={`Thumbnail de ${title.es}`}
              class="object-cover object-top w-full h-56 transition duration-500 grayscale-[20%] group-hover:grayscale-0 group-hover:scale-[1.03]"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="flex flex-col flex-1 w-full p-6 border-t-2 border-black dark:border-white">
          <h3 
            class="text-xl font-black leading-tight tracking-tight text-black uppercase dark:text-white i18n"
            data-es={title.es}
            data-en={title.en}
          >
            {title.es}
          </h3>
          
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-wrap gap-2 mb-2">
              {tags.map((tag) => (
                <li>
                  <span class={`flex items-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
                    <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-white/95" style={`color: ${tag.iconColor}`}>
                      <tag.icon class="size-3.5" />
                    </span>
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div 
              class="mt-3 text-sm leading-relaxed text-gray-700 dark:text-gray-300 i18n"
              data-es={description.es}
              data-en={description.en}
            >
              {description.es}
            </div>

            <footer class="flex items-end justify-start mt-6 gap-x-3">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  <span class="i18n" data-es="Código" data-en="Code">Código</span>
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  <span class="i18n" data-es="Enlace" data-en="Link">Enlace</span>
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>

<div id="project-tag-icons" class="hidden" aria-hidden="true">
  {
    Object.entries(TAGS).map(([key, tag]) => (
      <span data-project-tag-icon={key}>
        <tag.icon class="size-3.5" />
      </span>
    ))
  }
  <span data-project-action-icon="github">
    <GitHub class="size-6" />
  </span>
  <span data-project-action-icon="link">
    <Link class="size-4" />
  </span>
</div>

<script>
  import { collection, getDocs, query, where } from "firebase/firestore";
  import { db } from "@/lib/firebase";

  const PROJECT_TAGS = {
    NEXT: { name: "Next.js", className: "bg-black text-white", iconColor: "#000000" },
    TAILWIND: { name: "Tailwind CSS", className: "bg-[#003159] text-white", iconColor: "#38BDF8" },
    HTML: { name: "HTML", className: "bg-[#E34F2680] text-white", iconColor: "#E34F26" },
    CSS: { name: "CSS", className: "bg-[#264DE480] text-white", iconColor: "#1572B6" },
    VANILLAJS: { name: "VanillaJS", className: "bg-[#F7DF1E80] text-white", iconColor: "#F7DF1E" },
    BOOTSTRAP: { name: "Bootstrap", className: "bg-[#7952B380] text-white", iconColor: "#7952B3" },
    REACT: { name: "React", className: "bg-[#003159] text-white", iconColor: "#61DAFB" },
    SUPABASE: { name: "Supabase", className: "bg-[#1C3F2E] text-white", iconColor: "#3ECF8E" },
    ASTRO: { name: "Astro", className: "bg-[#E34F2680] text-white", iconColor: "#FF5D01" },
    VITE: { name: "Vite", className: "bg-[#646CFF] text-white", iconColor: "#646CFF" },
    TYPESCRIPT: { name: "TypeScript", className: "bg-[#3178C6] text-white", iconColor: "#3178C6" },
    FIREBASE: { name: "Firebase", className: "bg-[#FFCA28] text-black", iconColor: "#FFCA28" },
    PHP: { name: "PHP", className: "bg-[#777BB4] text-white", iconColor: "#777BB4" },
    ANGULAR: { name: "Angular", className: "bg-[#C3002F] text-white", iconColor: "#DD0031" },
    MYSQL: { name: "MySQL", className: "bg-[#00546B] text-white", iconColor: "#00758F" },
    NODE: { name: "Node.js", className: "bg-[#2F6B2F] text-white", iconColor: "#3C873A" },
    EXPRESS: { name: "Express", className: "bg-black text-white", iconColor: "#000000" },
    PYTHON: { name: "Python", className: "bg-[#3776AB] text-white", iconColor: "#3776AB" },
    DOCKER: { name: "Docker", className: "bg-[#2496ED] text-white", iconColor: "#2496ED" },
    POSTGRESQL: { name: "PostgreSQL", className: "bg-[#336791] text-white", iconColor: "#336791" },
    SQLSERVER: { name: "SQL Server", className: "bg-[#A91D22] text-white", iconColor: "#CC2927" },
    DOTNET: { name: ".NET", className: "bg-[#512BD4] text-white", iconColor: "#512BD4" },
    CSHARP: { name: "C#", className: "bg-[#68217A] text-white", iconColor: "#68217A" },
    BASH: { name: "Bash", className: "bg-[#293137] text-white", iconColor: "#293137" },
    JAVA: { name: "Java", className: "bg-[#E76F00] text-white", iconColor: "#E76F00" },
    SQLITE: { name: "SQLite", className: "bg-[#003B57] text-white", iconColor: "#003B57" },
  };
  const projectsContainer = document.getElementById("projects-container");
  const iconLibrary = document.getElementById("project-tag-icons");
  const linkButtonClass = "inline-flex min-w-28 items-center justify-center gap-2 px-3 py-2 text-xs font-black text-black uppercase transition border-2 border-black bg-[#c5ff4a] group hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black focus:outline-none [&>svg]:size-5 [&>svg]:shrink-0";

  function escapeHtml(value: unknown) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function iconHtml(selector: string) {
    return iconLibrary?.querySelector<HTMLElement>(selector)?.innerHTML.trim() ?? "";
  }

  function renderTag(tagKey: string) {
    const tag = PROJECT_TAGS[tagKey as keyof typeof PROJECT_TAGS];
    if (!tag) return "";

    return `
      <li>
        <span class="flex items-center gap-x-2 rounded-full text-xs ${tag.className} py-1 px-2">
          <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-white/95" style="color: ${tag.iconColor}">
            ${iconHtml(`[data-project-tag-icon="${tagKey}"]`)}
          </span>
          ${escapeHtml(tag.name)}
        </span>
      </li>
    `;
  }

  function renderProject(project: any) {
    const titleEs = project.title?.es ?? "";
    const titleEn = project.title?.en ?? titleEs;
    const descriptionEs = project.description?.es ?? "";
    const descriptionEn = project.description?.en ?? descriptionEs;
    const tags = Array.isArray(project.tags) ? project.tags : [];
    const featuredClass = project.featured ? " project-card-featured" : "";
    const githubLink = project.github
      ? `<a href="${escapeHtml(project.github)}" role="link" class="${linkButtonClass}">
          ${iconHtml('[data-project-action-icon="github"]')}
          <span class="i18n" data-es="Código" data-en="Code">Código</span>
        </a>`
      : "";
    const externalLink = project.link
      ? `<a href="${escapeHtml(project.link)}" role="link" class="${linkButtonClass}">
          ${iconHtml('[data-project-action-icon="link"]')}
          <span class="i18n" data-es="Enlace" data-en="Link">Enlace</span>
        </a>`
      : "";

    return `
      <article class="project-card flex flex-col overflow-hidden transition duration-200 border-2 border-black bg-white shadow-[8px_8px_0_#111] group hover:-translate-y-1 hover:shadow-[12px_12px_0_#111] dark:border-white dark:bg-[#111] dark:shadow-[8px_8px_0_#c5ff4a] dark:hover:shadow-[12px_12px_0_#c5ff4a]${featuredClass}">
        <div class="w-full">
          <div class="relative flex flex-col items-center overflow-hidden">
            <img
              alt="Thumbnail de ${escapeHtml(titleEs)}"
              class="object-cover object-top w-full h-56 transition duration-500 grayscale-[20%] group-hover:grayscale-0 group-hover:scale-[1.03]"
              loading="lazy"
              src="${escapeHtml(project.image)}"
            />
          </div>
        </div>

        <div class="flex flex-col flex-1 w-full p-6 border-t-2 border-black dark:border-white">
          <h3
            class="text-xl font-black leading-tight tracking-tight text-black uppercase dark:text-white i18n"
            data-es="${escapeHtml(titleEs)}"
            data-en="${escapeHtml(titleEn)}"
          >
            ${escapeHtml(titleEs)}
          </h3>

          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-wrap gap-2 mb-2">
              ${tags.map(renderTag).join("")}
            </ul>

            <div
              class="mt-3 text-sm leading-relaxed text-gray-700 dark:text-gray-300 i18n"
              data-es="${escapeHtml(descriptionEs)}"
              data-en="${escapeHtml(descriptionEn)}"
            >
              ${escapeHtml(descriptionEs)}
            </div>

            <footer class="flex items-end justify-start mt-6 gap-x-3">
              ${githubLink}
              ${externalLink}
            </footer>
          </div>
        </div>
      </article>
    `;
  }

  async function hydrateProjectsFromFirestore() {
    if (!projectsContainer) return;

    try {
      const snapshot = await getDocs(query(
        collection(db, "projects"),
        where("visible", "==", true),
        where("status", "==", "published"),
      ));
      const remoteProjects = snapshot.docs
        .map((projectDoc) => projectDoc.data())
        .sort((a, b) => Number(a.order ?? 0) - Number(b.order ?? 0));

      if (remoteProjects.length === 0) return;

      projectsContainer.innerHTML = remoteProjects.map(renderProject).join("");
      projectsContainer.dataset.source = "firestore";
      updateProjectsLanguage();
    } catch (error) {
      console.error(error);
    }
  }

  // Script genérico: no necesita conocer los datos de los proyectos
  function updateProjectsLanguage() {
    const lang = localStorage.getItem('language') || 'es';
    const elements = document.querySelectorAll('.i18n');
    
    elements.forEach(el => {
      const translation = el.getAttribute(`data-${lang}`);
      if (translation) {
        el.textContent = translation;
      }
    });
  }
  
  // Ejecución inicial y escucha de eventos
  updateProjectsLanguage();
  hydrateProjectsFromFirestore();
  window.addEventListener('languageChanged', updateProjectsLanguage);
</script>

<style>
  @media (min-width: 768px) {
    .project-card-featured {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
    }

    .project-card-featured > div:first-child img {
      height: 100%;
      min-height: 25rem;
    }

    .project-card-featured > div:last-child {
      border-top: 0;
      border-left: 2px solid currentColor;
      justify-content: center;
    }
  }
</style>
