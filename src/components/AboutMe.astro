---
import { about } from "@/data/content";
---

<article
  class="relative flex flex-col items-center justify-center gap-8 p-7 overflow-hidden text-gray-800 border-2 border-black bg-white shadow-[10px_10px_0_#111] dark:border-white dark:bg-[#111] dark:shadow-[10px_10px_0_var(--p-accent,#a7bcd9)] dark:text-gray-200 md:flex-row md:p-12"
  id="about-container"
>
	  <div
	    id="about-content"
	    class="relative z-10 grid gap-6 md:grid-cols-3 md:gap-8 [&>p]:leading-relaxed [&>p>strong]:bg-[var(--p-accent,#a7bcd9)] [&>p>strong]:px-1 [&>p>strong]:text-[var(--p-accent-ink,#17202b)] [&>p>strong]:font-black text-pretty order-2 md:order-1"
	  >
    {
      about.map((paragraph) => (
        <p
          class="i18n-html"
          data-es={paragraph.es}
          data-en={paragraph.en}
          set:html={paragraph.es}
        />
      ))
    }
  </div>
</article>

<script>

  function updateAboutLanguage() {
    const lang = localStorage.getItem('language') || 'es';
    const elements = document.querySelectorAll('.i18n-html');

    elements.forEach(el => {
      const translation = el.getAttribute(`data-${lang}`);
      if (translation) {
        // Usamos innerHTML en lugar de textContent porque tenemos etiquetas <br> y <strong>
        el.innerHTML = translation;
      }
    });
  }


  updateAboutLanguage();
  window.addEventListener('languageChanged', updateAboutLanguage);
</script>
