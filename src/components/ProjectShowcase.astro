---
const cases = [
  { id: "marsan-mpms", name: "MPMS", context: ["Industria · Grupo Marsan", "Industry · Grupo Marsan"], problem: ["Conectar la operación de planta con el ERP.", "Connecting shop-floor operations with the ERP."], contribution: ["Trazabilidad, calidad y declaraciones mediante colas persistentes y reintentos.", "Traceability, quality and production reporting through persistent queues and retries."], stack: "C# / .NET / SQL Server" },
  { id: "marsan-cotizador", name: "Cotizador", context: ["Negocio · Grupo Marsan", "Business · Grupo Marsan"], problem: ["Convertir costes industriales en ofertas controladas.", "Turning industrial costs into controlled quotations."], contribution: ["Cálculo por proceso, simulaciones, versiones de precio y circuitos de aprobación.", "Process-based costing, simulations, price versions and approval workflows."], stack: "Blazor / .NET / SQL Server" },
  { id: "zaizen", name: "ZaiZen", context: ["Producto · Proyecto personal", "Product · Personal project"], problem: ["Entender las finanzas sin hojas de cálculo dispersas.", "Understanding finances without scattered spreadsheets."], contribution: ["Importación bancaria, presupuestos y objetivos con datos privados por usuario.", "Bank imports, budgets and savings goals with private per-user data."], stack: "React / Supabase / PostgreSQL" },
];
---
<section id="project-showcase" aria-labelledby="showcase-title">
  <div class="showcase-pin">
    <div class="showcase-heading"><div>
      <p class="i18n" data-es="Tres formas de resolver problemas" data-en="Three ways to solve problems">Tres formas de resolver problemas</p>
      <h2 id="showcase-title" class="i18n" data-es="Software con propósito." data-en="Software with purpose.">Software con propósito.</h2>
    </div></div>
    <div class="selected-cases">
      {cases.map((item, index) => (
        <a class="selected-case" href={`#project-${item.id}`}>
          <span class="case-topline"><span class="i18n" data-es={item.context[0]} data-en={item.context[1]}>{item.context[0]}</span><span class="case-number">0{index + 1}</span></span>
          <h3>{item.name}</h3>
          <p class="case-problem i18n" data-es={item.problem[0]} data-en={item.problem[1]}>{item.problem[0]}</p>
          <p class="case-contribution i18n" data-es={item.contribution[0]} data-en={item.contribution[1]}>{item.contribution[0]}</p>
          <span class="case-stack">{item.stack}</span>
          <span class="case-link"><span class="i18n" data-es="Explorar proyecto" data-en="Explore project">Explorar proyecto</span><span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </div>
</section>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  let cleanup: (() => void) | undefined;
  function initialize() {
    cleanup?.();
    const section = document.getElementById("project-showcase");
    if (!section) return;
    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(section.querySelectorAll(".selected-case"), {
        y: 28, opacity: 0, duration: 0.7, stagger: 0.1, ease: "power3.out",
        scrollTrigger: { trigger: section, start: "top 85%", once: true }, clearProps: "transform,opacity",
      });
    }, section);
    cleanup = () => media.revert();
  }
  initialize();
  document.addEventListener("astro:page-load", initialize);
  document.addEventListener("astro:before-swap", () => { cleanup?.(); cleanup = undefined; });
</script>
<style>
  .selected-cases { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .selected-case { display: flex; flex-direction: column; min-width: 0; padding: clamp(1.25rem, 2.5vw, 2rem); border: 1px solid var(--p-line); background: var(--p-panel); color: var(--p-ink); transition: border-color 240ms, background 240ms; }
  .case-topline { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; color: var(--p-muted); font-size: 0.6875rem; }
  .case-number { font-family: ui-monospace, monospace; color: var(--p-accent-text); }
  h3 { margin-top: 2rem; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 700; letter-spacing: -0.045em; }
  .case-problem { margin-top: 0.75rem; font-size: 1.0625rem; line-height: 1.5; }
  .case-contribution { margin-top: 1rem; margin-bottom: 1.75rem; font-size: 0.875rem; line-height: 1.65; color: var(--p-muted); }
  .case-stack { margin-top: auto; font: 0.6875rem/1.5 ui-monospace, monospace; color: var(--p-accent-text); }
  .case-link { display: flex; align-items: center; justify-content: space-between; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--p-line); font-size: 0.8125rem; }
  .case-link > span:last-child { transition: transform 240ms; font-size: 1.25rem; }
  .selected-case:hover, .selected-case:focus-visible { border-color: var(--p-accent); background: color-mix(in srgb, var(--p-accent) 6%, var(--p-panel)); }
  .selected-case:hover .case-link > span:last-child, .selected-case:focus-visible .case-link > span:last-child { transform: translate(3px, -3px); }
  @media (max-width: 63.999rem) { .selected-cases { grid-template-columns: 1fr; } h3 { margin-top: 1rem; } }
  @media (prefers-reduced-motion: reduce) { .selected-case, .case-link > span:last-child { transition: none; } }
</style>
