---
const currentYear = new Date().getFullYear();
---

<footer
  class="m-4 min-[375px]:pl-4 md:pl-0 mt-24 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center border-t-2 border-black dark:border-white"
  id="footer-container"
>
  <div
    class="rounded-lg w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between py-4"
  >
    <span class="text-sm font-bold sm:text-center text-zinc-800/90 dark:text-zinc-200/90">
      © {currentYear} Hugo Alén
    </span>
    <ul
      class="flex flex-wrap items-center mt-3 text-sm font-medium dark:text-white/90 sm:mt-0"
    >
      <li>
        <a
          id="footer-contact"
          href="mailto:hugoaalen@gmail.com"
          class="hover:underline me-4 md:me-6">Contacto</a
        >
      </li>
      <li>
        <a href="/#hero" class="hover:underline" id="footer-top">Volver arriba &uarr;</a>
      </li>
    </ul>
  </div>
</footer>

<script>
  const translations = {
    es: {
      contact: "Contacto",
      top: "Volver arriba &uarr;"
    },
    en: {
      contact: "Contact",
      top: "Back to top &uarr;"
    }
  };
  
  function updateFooterLanguage() {
    const lang = localStorage.getItem('language') || 'es';
    const t = translations[lang as keyof typeof translations] || translations.es;
    
    const contactEl = document.getElementById('footer-contact');
    if (contactEl) contactEl.textContent = t.contact;
    
    const topEl = document.getElementById('footer-top');
    if (topEl) topEl.innerHTML = t.top;
  }
  
  updateFooterLanguage();
  window.addEventListener('languageChanged', updateFooterLanguage);
</script>
