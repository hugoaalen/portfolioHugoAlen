<button
  id="language-toggle"
  class="relative inline-flex items-center justify-center w-10 h-10 text-black transition-colors hover:bg-black hover:text-white"
  aria-label="Change language"
>
  <span class="text-lg font-semibold">ES</span>
</button>

<script is:inline>
  const toggle = document.getElementById("language-toggle");
  
  function updateLanguageButton() {
    const currentLang = localStorage.getItem('language') || 'es';
    document.documentElement.lang = currentLang;
    if (toggle) toggle.textContent = currentLang.toUpperCase();
  }

  function updateHeaderDirectly() {
    const lang = localStorage.getItem('language') || 'es';
    const navLinks = document.querySelectorAll('header nav a.nav-link');
    
    const translations = {
      es: {
        experiencia: "Experiencia",
        proyectos: "Proyectos",
        formacion: "Formación",
        "sobre-mi": "Sobre mí"
      },
      en: {
        experiencia: "Experience",
        proyectos: "Projects",
        formacion: "Education",
        "sobre-mi": "About"
      }
    };

    const navItems = translations[lang];
    navLinks.forEach((link) => {
      const label = link.getAttribute('data-label');
      if (label && navItems[label]) {
        link.textContent = navItems[label];
      }
    });
  }
  
  toggle?.addEventListener("click", () => {
    const currentLang = localStorage.getItem('language') || 'es';
    const nextLang = currentLang === 'es' ? 'en' : 'es';
    localStorage.setItem('language', nextLang);
    console.log('Nuevo idioma:', nextLang);
    
    // Actualizar header directamente
    updateHeaderDirectly();
    
    // Emitir evento para otros componentes
    window.dispatchEvent(new Event('languageChanged'));
    
    // Actualizar el botón
    updateLanguageButton();
  });
  
  updateLanguageButton();
  updateHeaderDirectly();
</script>
