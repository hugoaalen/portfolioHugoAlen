---

<button
  id="language-toggle"
  type="button"
  class="relative inline-flex items-center justify-center w-10 h-10 text-black transition-colors hover:bg-black hover:text-white"
  aria-label="Change language"
>
  <span class="text-lg font-semibold">ES</span>
</button>

<script is:inline>
  (() => {
    const cleanupsKey = "__portfolioLanguageToggleCleanups";

    const initializeLanguageToggle = () => {
      window[cleanupsKey]?.forEach((cleanup) => cleanup());
      window[cleanupsKey] = [];

      const toggle = document.getElementById("language-toggle");
      if (!toggle) return;

      const translations = {
        es: {
          experiencia: "Experiencia",
          proyectos: "Proyectos",
          formacion: "Formación",
          "sobre-mi": "Sobre mí",
        },
        en: {
          experiencia: "Experience",
          proyectos: "Projects",
          formacion: "Education",
          "sobre-mi": "About",
        },
      };

      const updateLanguageButton = () => {
        const currentLang = localStorage.getItem("language") || "es";
        document.documentElement.lang = currentLang;
        toggle.textContent = currentLang.toUpperCase();
      };

      const updateHeaderDirectly = () => {
        const lang = localStorage.getItem("language") || "es";
        const navItems = translations[lang] || translations.es;

        document.querySelectorAll("header nav a.nav-link").forEach((link) => {
          const label = link.getAttribute("data-label");
          if (label && navItems[label]) {
            link.textContent = navItems[label];
          }
        });
      };

      const handleToggle = () => {
        const currentLang = localStorage.getItem("language") || "es";
        localStorage.setItem("language", currentLang === "es" ? "en" : "es");
        updateHeaderDirectly();
        window.dispatchEvent(new Event("languageChanged"));
        updateLanguageButton();
      };

      toggle.addEventListener("click", handleToggle);
      window[cleanupsKey].push(() => {
        toggle.removeEventListener("click", handleToggle);
      });

      updateLanguageButton();
      updateHeaderDirectly();
    };

    initializeLanguageToggle();
    document.addEventListener("astro:page-load", initializeLanguageToggle);
  })();
</script>
