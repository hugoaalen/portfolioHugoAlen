---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import MobileNavigation from "./MobileNavigation.astro";
import { profile } from "@/data/content";
import { getOptimizedImagePath } from "@/lib/public-assets";

const items = [
  { id: "hero", es: "Inicio", en: "Home" },
  { id: "project-showcase", es: "Selección", en: "Selected work" },
  { id: "experiencia", es: "Experiencia", en: "Experience" },
  { id: "proyectos", es: "Proyectos", en: "Projects" },
  { id: "formacion", es: "Formación", en: "Education" },
  { id: "sobre-mi", es: "Sobre mí", en: "About" },
  { id: "footer-container", es: "Contacto", en: "Contact" },
];

const pillItems = items.filter((item) => item.id !== "hero" && item.id !== "project-showcase");
---

<header class="public-navigation" id="public-navigation">
  <MobileNavigation items={items} />

  <div class="floating-nav-wrap">
    <nav class="floating-nav" aria-label="Secciones" data-es-label="Secciones" data-en-label="Sections">
      <a href="/#hero" class="floating-nav-brand">
        <img
          src={getOptimizedImagePath(profile.image)}
          alt={profile.imageAlt}
          width="28"
          height="28"
          class="floating-nav-avatar"
        />
        <span class="floating-nav-name">{profile.name}</span>
      </a>

      <div class="floating-nav-links">
        {pillItems.map((item) => (
          <a href={`/#${item.id}`} data-section-link={item.id}>
            <span class="i18n" data-es={item.es} data-en={item.en}>{item.es}</span>
          </a>
        ))}
      </div>

      <div class="floating-nav-utilities" role="group" aria-label="Preferencias" data-es-label="Preferencias" data-en-label="Preferences">
        <ThemeToggle />
        <LanguageToggle />
      </div>
    </nav>
  </div>

  <span class="navigation-mobile-progress" aria-hidden="true"></span>
</header>

<style>
  .public-navigation {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    pointer-events: none;
  }

  .floating-nav-wrap {
    display: flex;
    justify-content: center;
    padding: calc(0.85rem + env(safe-area-inset-top, 0px)) max(0.75rem, env(safe-area-inset-right, 0px)) 0 max(0.75rem, env(safe-area-inset-left, 0px));
  }

  .floating-nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--p-line);
    background: color-mix(in srgb, var(--p-panel) 80%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.14);
    max-width: 100%;
  }

  .floating-nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.25rem 0.65rem 0.25rem 0.3rem;
    border-radius: 9999px;
    text-decoration: none;
    color: var(--p-ink);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    transition: background-color 150ms ease;
    flex-shrink: 0;
  }

  .floating-nav-brand:hover {
    background: color-mix(in srgb, var(--p-accent) 14%, transparent);
  }

  .floating-nav-avatar {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    object-fit: cover;
    border: 1px solid var(--p-line);
  }

  .floating-nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding-inline: 0.5rem;
    border-left: 1px solid var(--p-line);
  }

  .floating-nav-links a {
    padding: 0.45rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--p-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .floating-nav-links a:hover,
  .floating-nav-links a[aria-current="location"] {
    color: var(--p-ink);
    background: color-mix(in srgb, var(--p-accent) 16%, transparent);
  }

  .floating-nav-links a[aria-current="location"] {
    color: var(--p-accent-text);
  }

  .floating-nav-utilities {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--p-line);
    flex-shrink: 0;
  }

  .floating-nav-utilities :global(#theme-toggle-root) {
    display: flex;
    align-items: center;
    margin: 0;
  }

  .floating-nav-utilities :global(#theme-toggle-btn),
  .floating-nav-utilities :global(#language-toggle) {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 0.5rem;
    border-radius: 9999px;
    border: 0;
    background: transparent;
    color: var(--p-muted);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    transition: background-color 150ms ease, color 150ms ease;
    cursor: pointer;
  }

  .floating-nav-utilities :global(#theme-toggle-btn) {
    display: grid;
    place-items: center;
    width: 34px;
    padding: 0;
  }

  .floating-nav-utilities :global(.theme-toggle-icon) {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 17px;
    height: 17px;
    display: block;
  }

  .floating-nav-utilities :global(#theme-toggle-btn:hover),
  .floating-nav-utilities :global(#language-toggle:hover),
  .floating-nav-utilities :global(#theme-toggle-btn[aria-expanded="true"]) {
    background: color-mix(in srgb, var(--p-accent) 18%, transparent);
    color: var(--p-ink);
  }

  .floating-nav-utilities :global(#language-toggle) {
    gap: 0.35rem;
    padding-inline: 0.65rem;
  }

  .floating-nav-utilities :global([data-language-flag]) {
    width: 18px;
    height: 13px;
    border-radius: 2px;
  }

  .floating-nav-utilities :global(#themes-menu) {
    top: calc(100% + 0.65rem);
    bottom: auto;
    right: 0;
    left: auto;
    min-width: 9.5rem;
    padding: 0.35rem;
    border-radius: 1rem;
    border: 1px solid var(--p-line);
    background: var(--p-panel);
    color: var(--p-ink);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    transform-origin: top right;
  }

  .floating-nav-utilities :global(.themes-menu-option) {
    border-radius: 0.6rem;
    min-height: 38px;
    font-size: 0.75rem;
  }

  .floating-nav-utilities :global(.themes-menu-option:hover),
  .floating-nav-utilities :global(.themes-menu-option:focus-visible),
  .floating-nav-utilities :global(.themes-menu-option[aria-pressed="true"]) {
    background: var(--p-accent);
    color: var(--p-accent-ink);
  }

  .navigation-mobile-progress {
    display: none;
    position: fixed;
    inset: 0 0 auto;
    height: 3px;
    background: var(--p-accent-text);
    transform-origin: left;
    transform: scaleX(var(--reading-progress, 0));
    pointer-events: none;
  }

  @media (max-width: 1439px), (max-height: 679px), (hover: none) and (pointer: coarse) {
    .floating-nav-wrap { display: none; }
    .navigation-mobile-progress { display: block; }
  }

  @media (max-width: 479px) {
    .floating-nav-name { display: none; }
  }
</style>

<script>
  let cleanupNav: (() => void) | undefined;

  function setupFloatingNav() {
    cleanupNav?.();
    const header = document.getElementById("public-navigation");
    if (!header) return;

    const links = Array.from(header.querySelectorAll<HTMLAnchorElement>(".floating-nav-links a[data-section-link]"));
    const sections = links
      .map((link) => ({
        link,
        section: document.getElementById(link.dataset.sectionLink || ""),
      }))
      .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(entry.section));

    const updateProgressAndActive = () => {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(1, Math.max(0, window.scrollY / docHeight)) : 0;
      header.style.setProperty("--reading-progress", progress.toFixed(4));

      const threshold = window.innerHeight * 0.35;
      let activeId = "";
      for (const { section } of sections) {
        if (section.getBoundingClientRect().top <= threshold) {
          activeId = section.id;
        }
      }
      for (const { link, section } of sections) {
        if (section.id === activeId) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    const updateLang = () => {
      const lang = localStorage.getItem("language") || "es";
      header.querySelectorAll<HTMLElement>("[data-es-label]").forEach((el) => {
        const label = el.getAttribute(`data-${lang}-label`);
        if (label) el.setAttribute("aria-label", label);
      });
    };

    window.addEventListener("scroll", updateProgressAndActive, { passive: true });
    window.addEventListener("resize", updateProgressAndActive, { passive: true });
    window.addEventListener("languageChanged", updateLang);
    updateProgressAndActive();
    updateLang();

    cleanupNav = () => {
      window.removeEventListener("scroll", updateProgressAndActive);
      window.removeEventListener("resize", updateProgressAndActive);
      window.removeEventListener("languageChanged", updateLang);
    };
  }

  setupFloatingNav();
  document.addEventListener("astro:page-load", setupFloatingNav);
  document.addEventListener("astro:before-swap", () => cleanupNav?.());
</script>
