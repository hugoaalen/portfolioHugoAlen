---
import LinkInline from "./LinkInline.astro";

interface Props {
  title: string;
  company: string;
  link?: string;
  date: string;
}

const { title, company, link, date } = Astro.props;
---

<div
  class="relative h-full p-6 transition border-2 border-black bg-[#c5ff4a] shadow-[7px_7px_0_#111] hover:-translate-y-1 dark:border-white"
>
  <div class="relative">
    <div>
      <h3 class="text-lg font-black leading-tight text-black uppercase">{title}</h3>
      <h4 class="mt-2 font-bold text-gray-800">
        {company}
      </h4>
      <time class="inline-block p-1 mt-4 text-xs font-black tracking-wide text-white uppercase bg-black"
        >{date}</time
      >
    </div>
  </div>
  <div class="relative flex flex-col gap-2 text-gray-700">
    {
      link && (
        <LinkInline href={link}>
          Saber más{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
