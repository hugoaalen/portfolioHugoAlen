---
import LinkInline from "./LinkInline.astro";

interface Props {
  title: I18nText;
  company: string;
  link?: string;
  date: I18nText;
  variant?: "primary" | "secondary";
}

interface I18nText {
  es: string;
  en: string;
}

const { title, company, link, date, variant = "primary" } = Astro.props;
---

<div
  class:list={[
    "relative h-full transition border-2 border-black shadow-[7px_7px_0_#111] hover:-translate-y-1 dark:border-white",
    variant === "primary"
      ? "p-6 bg-[#c5ff4a]"
      : "p-5 bg-white dark:bg-[#111] dark:shadow-[7px_7px_0_#c5ff4a]",
  ]}
>
  <div class="relative">
    <div>
      <h3
        class:list={[
          "font-black leading-tight uppercase i18n",
          variant === "primary" ? "text-lg text-black" : "text-base text-black dark:text-white",
        ]}
        data-es={title.es}
        data-en={title.en}
      >
        {title.es}
      </h3>
      <h4 class:list={["mt-2 font-bold", variant === "primary" ? "text-gray-800" : "text-gray-700 dark:text-gray-300"]}>
        {company}
      </h4>
      <time
        class:list={[
          "inline-block p-1 mt-4 text-xs font-black tracking-wide uppercase i18n",
          variant === "primary" ? "text-white bg-black" : "text-black bg-[#c5ff4a]",
        ]}
        data-es={date.es}
        data-en={date.en}
        >{date.es}</time
      >
    </div>
  </div>
  <div class="relative flex flex-col gap-2 text-gray-700">
    {
      link && (
        <LinkInline href={link}>
          Saber más{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
