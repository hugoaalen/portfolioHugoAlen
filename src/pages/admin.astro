---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Administración - Hugo Alén"
  description="Panel privado para controlar la disponibilidad del portfolio"
>
  <main class="admin-main px-4 py-32 text-black bg-[#f6f6ef] dark:bg-[#050505] dark:text-white">
    <section class="w-full max-w-3xl p-6 mx-auto border-2 border-black bg-white shadow-[10px_10px_0_#111] dark:border-white dark:bg-[#111] dark:shadow-[10px_10px_0_#a7bcd9] sm:p-8">
      <p class="inline-block px-2 py-1 text-xs font-black tracking-[0.18em] uppercase bg-[#a7bcd9] text-black">
        Administración privada
      </p>

      <h1 class="mt-5 text-4xl font-black leading-none tracking-tight uppercase sm:text-5xl">
        Control del portfolio
      </h1>

      <p class="max-w-2xl mt-4 text-gray-700 dark:text-gray-300">
        Activa o desactiva la pantalla de mantenimiento. El contenido se mantiene en los JSON del proyecto.
      </p>

      <div id="admin-loading" class="p-4 mt-8 text-sm font-bold border-2 border-black dark:border-white">
        Comprobando sesión...
      </div>

      <div id="admin-login" class="hidden mt-8">
        <button
          id="admin-login-button"
          class="inline-flex items-center justify-center px-4 py-3 text-sm font-black text-black uppercase transition border-2 border-black bg-[#a7bcd9] hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black"
        >
          Entrar con Google
        </button>
      </div>

      <div id="admin-denied" class="hidden p-4 mt-8 text-sm font-bold text-white bg-red-700 border-2 border-black dark:border-white">
        Tu cuenta de Google no está autorizada para administrar este portfolio.
      </div>

      <div id="admin-panel" class="hidden mt-8">
        <div class="p-4 border-2 border-black dark:border-white">
          <p class="text-sm font-bold text-gray-700 dark:text-gray-300">Sesión iniciada como:</p>
          <p id="admin-user-email" class="mt-1 font-black"></p>
        </div>


        <section class="admin-dashboard-card p-5 mt-6 border-2" aria-labelledby="availability-title">
          <h2 id="availability-title" class="text-xl font-black">Visibilidad de la web</h2>
          <p id="availability-status" class="mt-3" role="status" aria-live="polite">Consultando estado...</p>
          <p class="mt-3 text-sm">Con mantenimiento activo, las nuevas visitas verán la pantalla de actualización. Este panel seguirá accesible.</p>
          <button id="availability-toggle" type="button" disabled class="px-4 py-3 mt-5 font-bold border-2" aria-describedby="availability-status">Cargando...</button>
          <button id="availability-refresh" type="button" class="px-4 py-3 mt-3 font-bold border-2">Comprobar estado</button>
          <p id="availability-error" class="mt-3 text-sm" role="alert" hidden></p>
        </section>
        <p class="mt-5 text-sm">Textos, proyectos y formación: archivos de <code>src/data/</code>. No se sustituyen desde Firebase.</p>

        <button
          id="admin-logout-button"
          class="px-4 py-3 mt-8 text-sm font-black uppercase transition border-2 border-black dark:border-white hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black"
        >
          Cerrar sesión
        </button>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { getRedirectResult, onAuthStateChanged, signInWithRedirect, signOut } from "firebase/auth";
  import { adminEmail, auth, db, googleProvider } from "@/lib/firebase";

  import { doc, getDocFromServer, serverTimestamp, setDoc } from "firebase/firestore";
  import { availabilityDocument } from "@/lib/site-availability";

  const toggle = document.getElementById("availability-toggle") as HTMLButtonElement;
  const refresh = document.getElementById("availability-refresh") as HTMLButtonElement;
  const status = document.getElementById("availability-status")!;
  const errorMessage = document.getElementById("availability-error")!;
  let maintenance = false;
  let busy = false;
  let loaded = false;
  const setting = doc(db, ...availabilityDocument);

  function renderAvailability() {
    toggle.disabled = busy || !loaded;
    refresh.disabled = busy;
    toggle.textContent = maintenance ? "Mostrar portfolio" : "Activar mantenimiento";
    toggle.setAttribute("aria-pressed", String(maintenance));
    status.textContent = loaded
      ? (maintenance ? "Mantenimiento activo: portfolio oculto." : "Portfolio visible para todos.")
      : "Estado sin verificar.";
  }

  function showError() {
    errorMessage.textContent = "No se pudo verificar o guardar el estado. Revisa la conexión y los permisos; no se confirma ningún cambio.";
    errorMessage.hidden = false;
  }

  async function loadAvailability() {
    if (busy || auth.currentUser?.email !== adminEmail) return;
    busy = true;
    loaded = false;
    errorMessage.hidden = true;
    renderAvailability();
    try {
      const snapshot = await getDocFromServer(setting);
      const value = snapshot.data()?.maintenanceEnabled;
      if (value !== undefined && typeof value !== "boolean") throw new Error("Invalid maintenance setting");
      maintenance = value ?? false;
      loaded = true;
    } catch {
      showError();
    } finally {
      busy = false;
      renderAvailability();
    }
  }

  toggle.addEventListener("click", async () => {
    const user = auth.currentUser;
    if (busy || !loaded || !user || user.email !== adminEmail || !user.emailVerified) return;
    const next = !maintenance;
    if (next && !window.confirm("¿Mostrar mantenimiento en lugar del portfolio para las nuevas visitas?")) return;
    busy = true;
    errorMessage.hidden = true;
    renderAvailability();
    try {
      await setDoc(setting, { maintenanceEnabled: next, availabilityUpdatedAt: serverTimestamp() }, { merge: true });
      maintenance = next;
    } catch {
      loaded = false;
      showError();
    } finally {
      busy = false;
      renderAvailability();
    }
  });
  refresh.addEventListener("click", loadAvailability);

  const loading = document.getElementById("admin-loading");
  const login = document.getElementById("admin-login");
  const denied = document.getElementById("admin-denied");
  const panel = document.getElementById("admin-panel");
  const userEmail = document.getElementById("admin-user-email");
  const loginButton = document.getElementById("admin-login-button");
  const logoutButton = document.getElementById("admin-logout-button");

  function showState(state: "loading" | "login" | "denied" | "panel") {
    loading?.classList.toggle("hidden", state !== "loading");
    login?.classList.toggle("hidden", state !== "login");
    denied?.classList.toggle("hidden", state !== "denied");
    panel?.classList.toggle("hidden", state !== "panel");
  }

  getRedirectResult(auth).catch((error) => {
    console.error(error);
    showState("login");
  });

  onAuthStateChanged(auth, (user) => {
    if (!user) {
      loaded = false;
      renderAvailability();
      showState("login");
      return;
    }

    if (user.email !== adminEmail || !user.emailVerified) {
      showState("denied");
      return;
    }

    if (userEmail) {
      userEmail.textContent = user.email || "";
    }

    showState("panel");
    void loadAvailability();
  });

  loginButton?.addEventListener("click", async () => {
    showState("loading");

    try {
      await signInWithRedirect(auth, googleProvider);
    } catch (error) {
      console.error(error);
      showState("login");
    }
  });

  logoutButton?.addEventListener("click", async () => {
    await signOut(auth);
  });
</script>
