---
import Layout from "@/layouts/Layout.astro";

import AboutMe from "@/components/AboutMe.astro";
import Books from "@/components/icons/Books.astro";
import Briefcase from "@/components/icons/Briefcase.astro";
import CodeIcon from "@/components/icons/Code.astro";
import Education from "@/components/Education.astro";
import Experience from "@/components/Experience.astro";
import ProfileCheck from "@/components/icons/ProfileCheck.astro";
import Projects from "@/components/Projects.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Hero from "@/components/Hero.astro";
---

<Layout
  title="Hugo Alén | Desarrollador web y diseñador gráfico"
  description="Contrata a Hugo para crear tu aplicación web o móvil. Desarrollador Web y Diseñador Gráfico. Especializado en llevar a cabo proyectos únicos."
>
  <main>
    <SectionContainer id="hero" class="py-16 md:py-36">
      <Hero />
    </SectionContainer>
  </main>
  <div class="space-y-24" id="main-sections">
    <SectionContainer id="experiencia">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white section-title"
        data-section="experience"
      >
        <Briefcase class="size-8" />
        Experiencia laboral
      </h2>
      <Experience />
    </SectionContainer>
    <SectionContainer id="proyectos">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white section-title"
        data-section="projects"
      >
        <CodeIcon class="size-7" />
        Proyectos
      </h2>
      <Projects />
    </SectionContainer>

    <SectionContainer id="formacion">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-3 text-black/80 dark:text-white section-title"
        data-section="education"
      >
        <Books class="size-8" />
        Formación
      </h2>
      <Education />
    </SectionContainer>

    <SectionContainer id="sobre-mi">
      <h2
        class="flex items-center mb-6 text-3xl font-semibold gap-x-8 text-black/80 dark:text-white section-title"
        data-section="about"
      >
        <ProfileCheck class="size-8" />
        Sobre mí
      </h2>
      <AboutMe />
    </SectionContainer>
  </div>

<script>
  /* @ts-nocheck */
  const sectionTitles = {
    es: {
      experience: "Experiencia laboral",
      projects: "Proyectos",
      education: "Formación",
      about: "Sobre mí"
    },
    en: {
      experience: "Work Experience",
      projects: "Projects",
      education: "Education",
      about: "About Me"
    }
  };
  
  function updateSectionTitles() {
    const lang = localStorage.getItem('language') || 'es';
    const titles = sectionTitles[lang as keyof typeof sectionTitles] || sectionTitles.es;

    /** @param {string|null} key */

    const sectionsContainer = document.getElementById('main-sections');
    if (!sectionsContainer) return;
    
    const titleElements = sectionsContainer.querySelectorAll('.section-title');
    titleElements.forEach((titleEl) => {
      const sectionKey = titleEl.getAttribute('data-section');
      let sectionTitle;
      switch (sectionKey) {
        case 'experience':
          sectionTitle = titles.experience;
          break;
        case 'projects':
          sectionTitle = titles.projects;
          break;
        case 'education':
          sectionTitle = titles.education;
          break;
        case 'about':
          sectionTitle = titles.about;
          break;
        default:
          sectionTitle = undefined;
      }

      if (sectionKey && sectionTitle) {
        const span = titleEl.querySelector('span');
        if (span) {
          titleEl.innerHTML = titleEl.innerHTML.replace(
            titleEl.textContent ?? "",
            sectionTitle
          );
        } else {
          const icon = titleEl.querySelector('svg');
          if (icon) {
            const iconClone = icon.cloneNode(true);
            titleEl.innerHTML = '';
            titleEl.appendChild(iconClone);
            titleEl.appendChild(document.createTextNode('\n        ' + sectionTitle));
          } else {
            titleEl.textContent = sectionTitle;
          }
        }
      }
    });
  }
  
  updateSectionTitles();
  window.addEventListener('languageChanged', updateSectionTitles);
</script>
</Layout>

